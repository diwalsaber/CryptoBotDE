FROM bitnami/spark:3.5

# Basculer vers l'utilisateur root pour installer les paquets
USER root

# Mettre à jour et installer pip si nécessaire, puis les paquets Python
RUN apt-get update && apt-get install -y python3-pip curl && \
    pip3 install --no-cache-dir pandas python-binance psycopg2-binary kafka-python && \
    # Télécharger le driver JDBC PostgreSQL s'il n'est pas inclus
    # Vérifier la version la plus récente ou celle compatible
    # Le chemin /opt/bitnami/spark/jars/ est un bon endroit
    # Assurez-vous que ce répertoire existe ou créez-le
    mkdir -p /opt/bitnami/spark/jars && \
    curl -L -o /opt/bitnami/spark/jars/postgresql-42.7.3.jar https://jdbc.postgresql.org/download/postgresql-42.7.3.jar && \
    apt-get purge -y --auto-remove curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Revenir à l'utilisateur par défaut de l'image Bitnami (généralement 1001)
USER 1001 